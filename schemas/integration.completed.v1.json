{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["integration_id", "status"],
    "properties": {
        "status": {
            "type": "string",
            "description": "The status of the integration completion.",
            "enum": ["success", "failed"]
        },
        "integration_id": {
            "type": "string",
            "minLength":1,
            "description": "The unique identifier of the completed integration."
        }
    }
}