{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["user_id", "email"],
    "properties": {
        "user_id": {
            "type": "string",
            "description": "The unique identifier of the created user.",
            "minLength": 1
        },
        "email": {
            "type": "string",
            "description": "The email address of the created user.",
            "minLength": 3
        }
    }
}